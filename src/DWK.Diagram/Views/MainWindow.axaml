<u:UrsaWindow xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:u="https://irihi.tech/ursa"
              xmlns:views="clr-namespace:DWK.Diagram.Views"
              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="DWK.Diagram.Views.MainWindow"
              Title="DWK.Diagram"
              Icon="avares://DWK.Diagram.Resource/Assets/dwk-logo.ico"
              IsFullScreenButtonVisible="True"
              IsManagedResizerVisible="True"
              IsTitleBarVisible="True">

    <u:UrsaWindow.RightContent>
        <StackPanel Orientation="Horizontal" Classes="Toolbar" Margin="16,0">
            <ToggleButton IsEnabled="False">
                <PathIcon Data="{StaticResource Folder-Minus}" />
            </ToggleButton>
            <ToggleButton IsEnabled="False" IsChecked="True">
                <PathIcon Data="{StaticResource Folder-Minus}" />
            </ToggleButton>
            <ToggleButton IsChecked="True">
                <PathIcon Data="{StaticResource Folder-Minus}" />
            </ToggleButton>

            <Button>
                <PathIcon Data="{StaticResource Palette}" />
                <Button.Flyout>
                    <Flyout>
                        <ListBox x:Name="PART_ThemeListBox" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button>
                <PathIcon Data="{StaticResource Info-Line}" />
            </Button>
            <Button IsEnabled="False">
                <PathIcon Data="{StaticResource Info-Line}" />
            </Button>
        </StackPanel>
    </u:UrsaWindow.RightContent>
    <views:MainView />
</u:UrsaWindow>