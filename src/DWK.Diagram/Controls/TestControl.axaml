<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:DWK.Diagram.Models;assembly=DWK.Diagram.Common"
             xmlns:avalonia="clr-namespace:Northwoods.Go.Avalonia;assembly=Northwoods.GoDiagram.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DWK.Diagram.Controls.TestControl"
             x:Name="RootControl"
             x:DataType="models:DiagramPage">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding #RootControl.Id}" />
            <TextBlock Text="{Binding Id}" />
        </StackPanel>
        <avalonia:DiagramControl x:Name="PART_DiagramControl"
            Background="LightYellow" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
    </DockPanel>
</UserControl>