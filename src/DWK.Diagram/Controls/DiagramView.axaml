<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Northwoods.Go.Avalonia;assembly=Northwoods.GoDiagram.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DWK.Diagram.Controls.DiagramControl">
    <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button DockPanel.Dock="Top" Content="XXX" Click="Button_OnClick" />
            <Button DockPanel.Dock="Top" Content="Spy" Click="SpyButton_OnClick" />
            <Button DockPanel.Dock="Top" Content="Tag" Click="TagButton_OnClick" />
        </StackPanel>

        <avalonia:DiagramControl Name="PART_DiagramControl" />
        <!-- <avalonia:DiagramControl Name="PART_DiagramControl" Background="#0061cc" /> -->
        <!-- <avalonia:DiagramControl Name="PART_DiagramControl" Background="#3B4166" /> -->
    </DockPanel>
    
    
</UserControl>