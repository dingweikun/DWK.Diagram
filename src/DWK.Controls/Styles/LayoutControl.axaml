<Style xmlns="https://github.com/avaloniaui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:local="using:DWK.Controls"
       Selector="local|LayoutControl">

    <Setter Property="Template">
        <ControlTemplate TargetType="local:LayoutControl">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ContentPresenter Grid.Column="0" x:Name="PART_ContentPresenter1" Content="{TemplateBinding SlotLeftSelectedItem}"
                                  IsVisible="{TemplateBinding SlotLeftSelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <Border Grid.Column="1" BorderThickness="1" BorderBrush="Red" />

                <ContentPresenter Grid.Column="2" x:Name="PART_ContentPresenter2" Content="{TemplateBinding SlotRightSelectedItem}"
                                  IsVisible="{TemplateBinding SlotRightSelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
        </ControlTemplate>
    </Setter>
</Style>