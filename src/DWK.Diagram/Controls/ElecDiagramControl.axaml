<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:go="using:Northwoods.Go.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DWK.Diagram.Controls.ElecDiagramControl"
             x:Name="RootControl">

    <DockPanel>
        <TextBlock Text="{Binding #RootControl.DiagramPage.Id}" DockPanel.Dock="Top" />
        <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Top">
            <Button DockPanel.Dock="Top" Content="XXX" Click="Button_OnClick" />
            <Button DockPanel.Dock="Top" Content="Spy" Click="SpyButton_OnClick" />
            <Button DockPanel.Dock="Top" Content="Tag" Click="TagButton_OnClick" />
        </StackPanel>

        <go:DiagramControl Name="PART_GoDiagramControl" />
    </DockPanel>


</UserControl>