<u:UrsaWindow xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:u="https://irihi.tech/ursa"
              xmlns:views="clr-namespace:DWK.Diagram.Views"
              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="DWK.Diagram.Views.MainWindow"
              Title="DWK.Diagram"
              Icon="avares://DWK.Diagram.Resource/Assets/dwk-logo.ico"
              IsFullScreenButtonVisible="True"
              IsManagedResizerVisible="True"
              IsTitleBarVisible="True">

    <u:UrsaWindow.RightContent>
        <TextBlock Text="this is right content" />
    </u:UrsaWindow.RightContent>

    <views:ExplorerPanelView />

</u:UrsaWindow>