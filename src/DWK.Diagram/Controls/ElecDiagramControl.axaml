<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:go="using:Northwoods.Go.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DWK.Diagram.Controls.ElecDiagramControl"
             x:Name="RootControl">

    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DividerBorderBrush}" BorderThickness="0,1,0,1">
            <Panel Classes="Header" Height="36">
                <StackPanel Classes="HeaderToolbar" HorizontalAlignment="Right" Margin="8,0">
                    <StackPanel.Styles>
                        <Style Selector=":is(Button)">
                            <Setter Property="Height" Value="26" />
                            <Setter Property="Width" Value="26" />
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </StackPanel.Styles>
                    <ToggleButton IsChecked="{Binding #RootControl.GridVisible}"
                                  Click="GridVisibleButton_OnClick">
                        <PathIcon Width="16" Height="16" Data="{StaticResource Grid-Line}" />
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding #RootControl.IsLoaded}"
                                  Click="IsLockedButton_OnClick">
                        <PathIcon Width="16" Height="16" Data="{StaticResource Lock-Line}" />
                    </ToggleButton>
                    <!-- <Button DockPanel.Dock="Top" Content="XXX" Click="Button_OnClick" /> -->
                    <!-- <Button DockPanel.Dock="Top" Content="Spy" Click="SpyButton_OnClick" /> -->
                    <!-- <Button DockPanel.Dock="Top" Content="Tag" Click="TagButton_OnClick" /> -->
                </StackPanel>
            </Panel>
        </Border>

        <go:DiagramControl Name="PART_GoDiagramControl" />
    </DockPanel>


</UserControl>